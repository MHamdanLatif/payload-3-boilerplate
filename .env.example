# Payload + Postgres
DATABASE_URI=postgres://user:password@localhost:5432/lateef_properties
PAYLOAD_SECRET=change-me

# Public site URL (used by Next.js + Payload for OG, sitemap, etc.)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Lead capture — Privyr webhook receiving zero-results form submissions
# Legacy fallback. The native CRM (ntfy alerts + wa.me send + CAPI below) now
# handles notifications. Leave unset in dev; set in prod if still forwarding.
PRIVYR_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Owner notifications — ntfy (free, no Meta setup, works from Pakistan, no VPN)
# The owner installs the ntfy app (iOS/Android) and subscribes to a PRIVATE topic
# (a long, hard-to-guess string). We POST alerts to it: new lead, brochure opened,
# brochure sent. Best-effort — if unset, the lead still saves silently.
#   NTFY_TOPIC   — the private topic string, e.g. lateef-crm-a1b2c3d4e5 (KEEP SECRET;
#                  anyone who knows it can read/post on ntfy.sh — rotate if leaked)
#   NTFY_SERVER  — base URL, default https://ntfy.sh. Set for a self-hosted instance.
#   NTFY_TOKEN   — optional bearer token (auth-protected / self-hosted topics)
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=

# Brochure re-open alert throttle. After alerting on an open, stay quiet this many
# hours, then alert again if the lead returns (a strong buying signal). 0 = every
# open. Default 2.
BROCHURE_REOPEN_COOLDOWN_HOURS=2

# Note: the lead-facing brochure message is sent MANUALLY via the "Send File"
# button (wa.me deep link) — no WhatsApp Business API, no template approval, no
# per-message cost. The message template is edited in the admin under
# CRM → CRM Settings (not an env var), so copy changes need no redeploy.

# ─────────────────────────────────────────────────────────────────────────────
# Meta Conversions API (CAPI) — server-side QualifiedLead / DisqualifiedLead
# Fires when an agent sets a lead's status to Qualified or Junk, so ad
# optimisation learns from real sales outcomes. Uses hashed phone/email + the
# fbclid/fbc captured at form submission, deduped against the browser Pixel via
# the shared eventId.
# ─────────────────────────────────────────────────────────────────────────────
#   META_CAPI_ACCESS_TOKEN     — Conversions API token (Events Manager → Settings)
#   META_PIXEL_ID              — defaults to NEXT_PUBLIC_META_PIXEL_ID if unset
#   META_GRAPH_VERSION         — Graph API version (default: v21.0)
#   META_CAPI_TEST_EVENT_CODE  — optional; set while testing in Events Manager, unset in prod
#   META_CAPI_QUALIFIED_EVENT  — event name sent on Qualified (default: QualifiedLead)
#   META_CAPI_JUNK_EVENT       — event name sent on Junk (default: DisqualifiedLead)
META_CAPI_ACCESS_TOKEN=
META_PIXEL_ID=
META_GRAPH_VERSION=v21.0
META_CAPI_TEST_EVENT_CODE=
META_CAPI_QUALIFIED_EVENT=QualifiedLead
META_CAPI_JUNK_EVENT=DisqualifiedLead

# Cloudflare R2 (S3-compatible) — media storage. The @payloadcms/storage-s3
# plugin in payload.config.ts reads these. Both local dev and Railway prod
# point at the same bucket so admin uploads from either environment are
# persistent and instantly available.
#   S3_BUCKET           — the R2 bucket name (lowercase, no spaces)
#   S3_ENDPOINT         — https://<account-id>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY_ID    — token from R2 → Manage R2 API Tokens
#   S3_SECRET_ACCESS_KEY — secret shown once when creating the token
#   S3_PUBLIC_URL       — Cloudflare-issued public dev URL for the bucket
S3_BUCKET=lateef-properties-media
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Meta Pixel — fires PageView site-wide via the layout, plus Lead on /thank-you.
# A hardcoded default ID is baked into `src/components/MetaPixel.tsx` so the pixel
# works without env config; set this here to override per-environment (e.g. staging).
NEXT_PUBLIC_META_PIXEL_ID=1007386375371716

# Google Analytics 4 — fires page_view site-wide via the layout (initial load
# + every client-side route change). A hardcoded default measurement ID is
# baked into `src/components/GoogleAnalytics.tsx` (carried over from the old
# site so historical reports stay continuous); set this here to override per
# environment.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-3SH3KB0RZS

# Google Ads conversion (optional) — fires on /thank-you only.
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Search-engine site ownership verification (Google Search Console + Bing Webmaster Tools).
# Inject the token they give you; the meta tag renders automatically when set.
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Manual blog workflow (iteration 14).
# No API keys needed — articles are written in your Claude Max chat and
# cover images generated in Gemini Pro, then pasted into /admin → Blogs.
# The CMS auto-derives excerpt/meta/read-time, auto-detects internal links
# (project + location mentions), and wraps them as Lexical link nodes on
# publish. See docs/blog-workflow.md for the step-by-step.
